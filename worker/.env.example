# Copy to worker/.env and fill in. Never commit worker/.env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=audiotruyen
# Optional: override the R2 endpoint (tests or other S3-compatible storage)
# R2_ENDPOINT_URL=
# Optional: defaults to the machine name
# WORKER_ID=laptop
LOG_LEVEL=INFO
# Cloud LLM for speaker/emotion analysis (M4). Only ":free" models are allowed by the code.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_LIMITS=rpm=20,rpd=50
# Cost protection (spec 7.3.1): uploads stop when off or when a cap is reached.
R2_UPLOADS_ENABLED=true
R2_MAX_BYTES=8589934592
R2_MAX_PUTS_PER_MONTH=800000
# TTS (spec 5.6): auto (CUDA if available, else ONNX on CPU) | cuda | cpu.
# Model files download to worker/models on first use (about 1 GB).
TTS_DEVICE=auto
# MODELS_DIR=
