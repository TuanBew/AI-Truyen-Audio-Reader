# Copy to web/.env.local. Local Supabase values come from: npx --yes supabase@2.121.0 status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Read-only R2 credentials, server-only (never NEXT_PUBLIC_*). Read lazily by the signed-URL route.
# Production: Cloudflare R2 read-only token. Local: values come from `npx --yes supabase@2.121.0 status -o env`.
R2_ACCOUNT_ID=local
# local: S3_PROTOCOL_ACCESS_KEY_ID and S3_PROTOCOL_ACCESS_KEY_SECRET
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
R2_BUCKET=audiotruyen
# Dev-only overrides; omit both in production (endpoint defaults to https://<account>.r2.cloudflarestorage.com, region to auto).
# local: STORAGE_S3_URL
R2_ENDPOINT_URL=
R2_REGION=local
